<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <queries>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.DISMISS_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SNOOZE_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent><action android:name="android.intent.action.DISMISS_TIMER" /></intent>
        <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
        <intent><action android:name="android.intent.action.SHOW_TIMERS" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.BROWSABLE" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT" /><category android:name="android.intent.category.OPENABLE" /><data android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.INSERT" /><data android:mimeType="vnd.android.cursor.dir/event" /></intent>
        <intent><action android:name="android.intent.action.CREATE_NOTE" /></intent>
        <intent><action android:name="com.google.android.gms.actions.CREATE_NOTE" /><data android:mimeType="text/plain" /></intent>
    </queries>
    <application>
        <provider android:name="app.familiar.platform.FamiliarUpdateProvider" android:authorities="${applicationId}.familiar.updates" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/familiar_update_paths" />
        </provider>
        <receiver android:name="app.familiar.platform.FamiliarBootReceiver" android:process=":runtime" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <provider android:name="app.familiar.platform.FamiliarCameraProvider" android:authorities="${applicationId}.familiar.camera" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/familiar_camera_paths" />
        </provider>
        <service android:name="app.familiar.platform.RuntimeService" android:process=":runtime" android:exported="false" />
        <service android:name="app.familiar.platform.VoiceService" android:process=":runtime" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="microphone|mediaPlayback" />
        <service android:name="app.familiar.platform.PetService" android:process=":runtime" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled persistent interactive companion overlay and ongoing conversation runtime with an explicit stop action" />
        </service>
        <service android:name="app.familiar.platform.FamiliarAccessibility" android:process=":runtime" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="灵伴手机操作">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/familiar_accessibility" />
        </service>
    </application>
</manifest>
