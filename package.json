{
  "name": "my-familiar",
  "version": "1.1.0",
  "private": true,
  "author": "mengxingGG",
  "repository": {
    "type": "git",
    "url": "https://github.com/mengxingGG/My-Familiar.git"
  },
  "description": "Familiar · 灵伴 — 插件驱动的独立桌面伙伴",
  "type": "module",
  "main": "dist/runtime.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "electron scripts/build-icons.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node scripts/launch.mjs runtime",
    "controller": "node scripts/launch.mjs controller",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "package:dir": "npm run build && electron-builder --dir",
    "package:release": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "smoke:agent": "node scripts/agent-smoke.mjs",
    "smoke:experience": "node scripts/experience-smoke.mjs",
    "smoke:integrations": "node scripts/integrations-smoke.mjs",
    "smoke:context": "node scripts/context-smoke.mjs",
    "smoke:voice": "node scripts/media-voice-smoke.mjs",
    "smoke:wake": "node scripts/wake-smoke.mjs",
    "smoke:integrations:packaged": "node scripts/integrations-smoke.mjs --packaged",
    "smoke:context:packaged": "node scripts/context-smoke.mjs --packaged",
    "check:cli": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/check-cli-dependencies.mjs",
    "smoke:agent:packaged": "node scripts/agent-smoke.mjs --packaged",
    "smoke:experience:packaged": "node scripts/experience-smoke.mjs --packaged",
    "mobile:build": "node scripts/build-mobile-ui.mjs",
    "mobile:preview": "node scripts/preview-mobile-ui.mjs",
    "smoke:mobile": "node scripts/smoke-mobile-ui.mjs",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "smoke:android": "node scripts/smoke-android-device.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.13.3",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "playwright": "1.61.1",
    "prettier": "^3.8.1",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "app.familiar.desktop",
    "productName": "Familiar",
    "artifactName": "Familiar-${version}-win-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/familiar.ico",
      "target": "dir",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Familiar-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "include": "scripts/installer.nsh"
    },
    "asarUnpack": [
      "dist/native/**",
      "dist/documents/**"
    ]
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@tauri-apps/api": "2.12.4",
    "@thednp/dommatrix": "3.1.2",
    "ajv": "8.18.0",
    "axios": "1.20.0",
    "mammoth": "1.12.3",
    "pdfjs-dist": "6.4.299",
    "pinyin-pro": "3.29.5",
    "ws": "8.21.3",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  }
}
