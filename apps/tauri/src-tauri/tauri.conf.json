{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Familiar",
  "version": "1.1.0",
  "identifier": "app.familiar.mobile",
  "build": {
    "frontendDist": "../../../dist/mobile-ui",
    "beforeDevCommand": "npm run mobile:build",
    "beforeBuildCommand": "npm run mobile:build"
  },
  "app": {
    "windows": [
      {
        "title": "Familiar",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 28
    }
  }
}
